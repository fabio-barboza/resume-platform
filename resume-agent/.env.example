# --- Agente principal ---
MAIN_MODEL=qwen3.6:35B
MAIN_MODEL_BASE_URL=http://localhost:8200/v1
MAIN_MODEL_API_KEY=not-needed
MAIN_MODEL_PROVIDER=openai

# --- Worker (busca, extração, resumo da pesquisa) ---
WORKER_MODEL=qwen3.6:35B
WORKER_MODEL_BASE_URL=http://localhost:8200/v1
WORKER_MODEL_API_KEY=not-needed
WORKER_MODEL_PROVIDER=openai

# --- Embeddings ---
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_MODEL_BASE_URL=http://localhost:8892/v1
EMBEDDING_MODEL_API_KEY=not-needed
# Dimensão do vetor gerado pelo modelo acima. Precisa bater com a coluna
# chunks.embedding: trocar de modelo exige uma migração nova, não só mudar
# esta variável.
EMBEDDING_DIM=1024

# --- Postgres / pgvector ---
# O docker-compose usa POSTGRES_* para criar o banco; a aplicação monta a URL
# a partir delas. DATABASE_URL, se definida, tem precedência.
POSTGRES_DB=resume_agent
POSTGRES_USER=resume_agent
POSTGRES_PASSWORD=resume_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://resume_agent:resume_agent@localhost:5432/resume_agent
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# Banco usado pela suíte de testes. Ela apaga e recria este banco a cada
# execução, então ele nunca pode ser o mesmo de POSTGRES_DB.
# TEST_POSTGRES_DB=resume_agent_test

# --- API de currículos ---
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=warning
# Quantas páginas iniciais do PDF alimentam a extração de nome/email/telefone.
EXTRACTION_PAGES=2
# Teto de páginas por currículo. Acima disso a ingestão é recusada (422), antes
# de gastar LLM e embedding. Guardrail de custo: cada página vira chunk, e cada
# chunk vira uma chamada ao modelo de embedding.
MAX_RESUME_PAGES=3

# --- Guardrail de custo do agente ---
# Teto de buscas que o agente pode fazer por pergunta do usuário. Zera a cada
# pergunta nova. Passando do teto, a busca excedente não roda e o agente
# responde com o que já recuperou, avisando que a busca foi parcial. Baixar
# para 2 ou 3 deixa o agente mais econômico e mais raso; subir dá respostas
# mais completas em perguntas amplas, ao custo de mais embeddings e tokens.
MAX_TOOL_CALLS_PER_QUESTION=5

# --- Bucket dos PDFs (S3 / compatível com S3) ---
# A aplicação fala com o bucket via boto3 (SDK da AWS). S3_ENDPOINT_URL
# aponta para o MinIO local, subido pelo docker-compose com as mesmas
# credenciais (MINIO_ROOT_*). Para usar AWS S3 de verdade: apague
# S3_ENDPOINT_URL e troque AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY pelas
# credenciais da conta — nenhum código muda.
# O bucket é criado automaticamente pela aplicação se não existir.
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_REGION=us-east-1
S3_BUCKET=resume-agent-bucket
S3_ENDPOINT_URL=http://localhost:9000

# --- Observabilidade (Langfuse) ---
# Desligado por padrão: a aplicação roda inteira sem Langfuse no ar, sem
# callback no agente e sem observation nos embeddings. Ligue com `true` para
# ver cada pergunta virar um trace (guardrails, tool calls, embeddings, tokens
# e latência). Ligado mas com chave errada ou serviço fora do ar, a aplicação
# avisa no log e segue sem tracing — instrumentação não derruba o que observa.
# O Langfuse não sobe pelo docker-compose deste projeto.
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="http://localhost:8060"
